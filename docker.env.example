# Copy to docker.env for local Docker (docker.env is gitignored)
NODE_ENV=production
PORT=3000
JWT_SECRET=local-docker-test-secret-at-least-32-chars
ADMIN_PASSWORD=change-me-min-6-chars
DB_PATH=/app/data/cbquiz.db
# MinIO trong cùng compose: server dùng hostname nội bộ, presigned URL cho browser dùng localhost
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=lectures
STORAGE_REGION=auto
