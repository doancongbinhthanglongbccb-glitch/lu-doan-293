PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production-use-at-least-32-random-chars
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:8080
DB_PATH=./database/cbquiz.db
BCRYPT_ROUNDS=10
# Required on first migrate — creates admin 00000001 (password is NOT stored in code)
ADMIN_PASSWORD=change-me-before-migrate

# Object storage (MinIO local / Cloudflare R2 production) — KHÔNG lưu file trên disk SQLite
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=lectures
STORAGE_REGION=auto
# URL trình duyệt gọi PUT/GET. Local npm run dev: có thể bỏ (fallback = STORAGE_ENDPOINT).
# Docker compose (backend trong container): STORAGE_ENDPOINT=http://minio:9000 và set dòng dưới.
# STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# Sevalla production example:
# NODE_ENV=production
# DB_PATH=/app/data/cbquiz.db
# AUTH_RATE_LIMIT=0   # tắt tạm giới hạn login (bật lại: 1 hoặc xóa biến)
# (mount persistent disk at /app/data in Sevalla Disks)
